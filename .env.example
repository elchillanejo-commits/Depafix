# =========================
# Supabase
# =========================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Opcional: por defecto se deriva de SUPABASE_URL
SUPABASE_JWKS_URL=
# Solo para proyectos legados con JWT HS256
SUPABASE_JWT_SECRET=dev-only-change-me
SUPABASE_LEGACY_JWT_SECRET=

# =========================
# IA
# =========================
OPENAI_API_KEY=sk-your-openai-key
OPENCODE_API_KEY=your-opencode-key

# =========================
# Postgres local (docker compose)
# =========================
POSTGRES_USER=depafix
POSTGRES_PASSWORD=depafix_dev_password
POSTGRES_DB=depafix
# Puerto del host (el 5432 suele estar ocupado por otro Postgres).
POSTGRES_PORT=5433
# URL para conectarte desde tu máquina. El servicio api usa db:5432 por dentro.
DATABASE_URL=postgresql://depafix:depafix_dev_password@localhost:5433/depafix

# =========================
# Puertos / Frontend
# =========================
API_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
