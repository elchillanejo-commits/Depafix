# =========================
# Supabase
# =========================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_DB_KEY=your_supabase_server_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Opcional: por defecto se deriva de SUPABASE_URL
SUPABASE_JWKS_URL=
# Solo para proyectos legados con JWT HS256
SUPABASE_JWT_SECRET=dev-only-change-me
SUPABASE_LEGACY_JWT_SECRET=

# =========================
# API / Seguridad / Rate Limit
# =========================
# Exige el header X-API-Key en endpoints críticos (/api/v1/cotizaciones/,
# /api/v1/rag/buscar, /api/v1/presupuesto/csv). Si no se define, la API opera
# en modo desarrollo (pasa con warning en logs).
DEPAFIX_API_KEY=
# Orígenes CORS permitidos (comma-separated). Ej: http://localhost:8501,http://localhost:8502
CORS_ORIGINS=http://localhost:8501,http://localhost:8502
# Rate limit ligero en memoria por IP + ruta
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# =========================
# IA
# =========================
OPENAI_API_KEY=sk-your-openai-key
OPENCODE_API_KEY=your-opencode-key

# =========================
# Postgres local (docker compose)
# =========================
POSTGRES_USER=depafix
POSTGRES_PASSWORD=depafix_dev_password
POSTGRES_DB=depafix
# Puerto del host (el 5432 suele estar ocupado por otro Postgres).
POSTGRES_PORT=5433
# URL para conectarte desde tu máquina. El servicio api usa db:5432 por dentro.
DATABASE_URL=postgresql://depafix:depafix_dev_password@localhost:5433/depafix

# =========================
# Puertos / Frontend
# =========================
API_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
