FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

# Sin CMD hardcoded — Railway usa el COMMAND env var
# El COMMAND se configura en el dashboard de Railway
CMD ["python3", "src/trading/trading_orchestrator.py", \
     "--exchange", "kraken", \
     "--activos", "BTC/USDT,SOL/USDT,LINK/USDT,ETH/USDT", \
     "--intervalo", "300", \
     "--modo", "simulacion"]
